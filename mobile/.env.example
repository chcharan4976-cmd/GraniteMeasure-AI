# GraniteMeasure AI — Mobile environment variables
#
# Copy this file to .env and set EXPO_PUBLIC_API_URL to your backend host.
# This is required when running on a physical Android device (not the emulator).
#
# Examples:
#   Local network (replace with your machine's LAN IP):
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
#
#   Android emulator (default, no .env needed):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#
#   iOS simulator (default, no .env needed):
#   EXPO_PUBLIC_API_URL=http://localhost:8000
#
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
